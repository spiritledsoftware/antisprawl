{
  "name": "antisprawl",
  "version": "0.0.0",
  "description": "Keep your agent from writing spaghetti code.",
  "type": "module",
  "scripts": {
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:staged": "lint-staged",
    "prepare": "husky",
    "build": "bun build --compile src/main.ts --outfile dist/antisprawl",
    "test": "vitest run && bun test tests/bun tests/acceptance",
    "test:vitest": "vitest run",
    "test:bun": "bun test tests/bun tests/acceptance",
    "typecheck": "tsc --noEmit",
    "verify": "bun run format:check && bun run lint && bun run typecheck && bun run test"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.0-beta.107",
    "@effect/platform-node-shared": "4.0.0-beta.107",
    "@effect/sql-sqlite-bun": "4.0.0-beta.107",
    "effect": "4.0.0-beta.107",
    "web-tree-sitter": "0.27.0"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-beta.107",
    "@oxlint/plugins": "1.83.0",
    "@types/bun": "1.4.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tree-sitter-cli": "0.24.4",
    "typescript": "^7.0.2",
    "vitest": "4.1.11"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2",
      "onFail": "error"
    }
  }
}
