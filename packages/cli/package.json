  "scripts": {
    "build": "bun build --compile src/main.ts --outfile dist/antisprawl"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.0-rc.115",
    "@effect/sql-sqlite-bun": "4.0.0-rc.115",
